{
  "name": "busy-day-at-the-viv-v2",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "A retro-noir browser adventure about one professionally chaotic shift at the Viv.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:preview": "playwright test --config=playwright.preview.config.ts",
    "test:e2e:public": "playwright test --config=playwright.public.config.ts",
    "verify:release": "python scripts/verify_release.py",
    "qa:visual": "node scripts/capture_visual_qa.mjs",
    "qa:performance": "node scripts/measure_performance.mjs",
    "assets:optimize": "node scripts/optimize_art.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "eslint": "10.7.0",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
